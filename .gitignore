# Android/Gradle outputs
**/.gradle/
**/build/
!/targets/afzh3/brazilian-open-payload-engine/build/
!/targets/zzhl/brazilian-open-payload-engine/build/
**/.cxx/
local.properties

# Generated/distributable binaries
*.aab
*.elf
*.img
*.zip
*.tar
*.tar.*
*.bin
# The unpacked kernel/ramdisk are raw firmware extracts (~46 MB) that no other
# target commits; they are reproducible from boot.img and the contract only
# needs the derived artifacts (config, kallsyms, BTF, CRC table).
targets/dyi3/firmware/unpacked/
# Device dmesg captures are diagnostics from the porter's own phone, not
# build inputs; regenerate with RMG_DIAG_CAPTURE=1 when needed.
assets-dyi3/diag/
# Staging directory: simple-root-dyi3.sh rebuilds and repopulates it on every
# run, so the copies are redundant with the target's own build outputs.
assets-dyi3/
targets/afzh3/kernelsu-next/out/
targets/afzg1/kernelsu-next/out/
simple-root/evidence/
simple-root/assets/*
!simple-root/assets/ksud-selected
!simple-root/assets/android13-5.15_kernelsu.ko

# Local secrets and signing material
*.jks
*.keystore
.env
.env.*

# Device/runtime logs
*.log
exploit.log

# Python virtualenvs / caches
.venv/
__pycache__/
*.pyc
